# Copy thành .env và điền giá trị thật. KHÔNG commit .env.

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# State
REDIS_URL=redis://localhost:6379/0

# Security — bắt buộc khi ENVIRONMENT=production
AGENT_API_KEY=
# Hoặc nhiều key: AGENT_API_KEYS=key1:alice,key2:bob

# Limits
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10

# LLM — để trống dùng mock
OPENAI_API_KEY=
LLM_MODEL=mock-llm
