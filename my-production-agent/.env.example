# Copy thành .env và điền giá trị thật. KHÔNG commit .env.

# Gateway
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# Security — bắt buộc khi ENVIRONMENT=production
AGENT_API_KEY=
# Hoặc nhiều key: AGENT_API_KEYS=key1:alice,key2:bob

# Limits
RATE_LIMIT_PER_MINUTE=10
MONTHLY_BUDGET_USD=10

# Legal Multi-Agent System (chạy nội bộ container, không cần đổi)
CUSTOMER_AGENT_URL=http://localhost:10100
REGISTRY_URL=http://localhost:10000
AGENT_TIMEOUT_SECONDS=300

# LLM của các agents — OpenRouter (bắt buộc để agents trả lời thật)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.3
